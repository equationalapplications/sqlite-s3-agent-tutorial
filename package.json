    "@aws-sdk/client-s3": "^3.1142.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@smithy/util-stream": "^4.8.2",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.271.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
